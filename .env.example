# Biến môi trường hệ thống HK Student Hub – THPT Hương Khê
DJANGO_SECRET_KEY=huong-khe-production-super-secret-key-change-me-in-production-2026
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,studenthub.thpthuongkhe.edu.vn

# Cơ sở dữ liệu (Mặc định SQLite cục bộ, cấu hình sang PostgreSQL khi triển khai)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Cấu hình PostgreSQL (Triển khai chính thức):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=hk_student_hub_db
# DB_USER=hk_hub_user
# DB_PASSWORD=hk_hub_secure_password
# DB_HOST=postgres
# DB_PORT=5432

# Thời gian và ngôn ngữ
TIME_ZONE=Asia/Ho_Chi_Minh
LANGUAGE_CODE=vi



# Cấu hình gửi Email (Khôi phục mật khẩu & Thông báo vi phạm Đoàn trường)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
GMAIL_SENDER_EMAIL=
# Chỉ điền App Password; không dùng mật khẩu đăng nhập Gmail. Không commit secret.
GMAIL_APP_PASSWORD=

# Email thông báo Đoàn trường được lấy tự động từ các tài khoản Đoàn trường hợp lệ (đã được Admin duyệt) trong hệ thống.

# URL gốc của hệ thống phục vụ tạo liên kết đặt lại mật khẩu và xem chi tiết vi phạm
FRONTEND_BASE_URL=http://127.0.0.1:8000
PASSWORD_RESET_TIMEOUT=86400

# Cấu hình Google OAuth 2.0 (Đăng nhập & Đăng ký bằng Google)
# Tạo thông tin xác thực OAuth 2.0 Client ID trên Google Cloud Console (https://console.cloud.google.com/apis/credentials):
# - Loại ứng dụng: Web Application
# - URI chuyển hướng được ủy quyền (Authorized redirect URIs):
#     + Cục bộ (Dev): http://127.0.0.1:8000/api/core/auth/google/callback/
#     + Triển khai: https://www.edumentor.io.vn/api/core/auth/google/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=

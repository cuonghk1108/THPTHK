# Biến môi trường hệ thống HK Student Hub – THPT Hương Khê
DJANGO_SECRET_KEY=huong-khe-production-super-secret-key-change-me-in-production-2026
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,studenthub.thpthuongkhe.edu.vn

# Cơ sở dữ liệu (Mặc định SQLite cục bộ, cấu hình sang PostgreSQL khi triển khai)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Cấu hình PostgreSQL (Triển khai chính thức):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=hk_student_hub_db
# DB_USER=hk_hub_user
# DB_PASSWORD=hk_hub_secure_password
# DB_HOST=postgres
# DB_PORT=5432

# Thời gian và ngôn ngữ
TIME_ZONE=Asia/Ho_Chi_Minh
LANGUAGE_CODE=vi
